<style>
    .r-switch { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
    .r-switch input { opacity: 0; width: 0; height: 0; }
    .r-switch .track { position: absolute; inset: 0; border-radius: 999px; background: #e6e9e1; transition: .2s; }
    .r-switch .track::before { content: ''; position: absolute; height: 18px; width: 18px; top: 3px; right: 3px; background: #fff; border-radius: 50%; transition: .2s; box-shadow: 0 1px 2px rgba(0,0,0,.25); }
    .r-switch input:checked + .track { background: #0e6a38; }
    .r-switch input:checked + .track::before { transform: translateX(-20px); }
</style>

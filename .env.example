APP_NAME="نظام ملاحظات المراقبة"
APP_ENV=local
APP_KEY=
# تحذير أمني: لا تضبط APP_DEBUG=true في الإنتاج إطلاقاً — يعرض Stack Traces ومسارات السيرفر.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ولّد قيمة عشوائية: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# التطبيق يرفض الإقلاع إذا كان السر فارغاً أو أقصر من 32 حرفاً.
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

MAX_IMAGE_SIZE=20480
MAX_VIDEO_SIZE=102400
MAX_ATTACHMENTS_PER_NOTE=10
MAX_AUDIO_SIZE=104857600
IMAGE_MAX_DIMENSION=1920
IMAGE_JPEG_QUALITY=82
IMAGE_WEBP_QUALITY=80
# للرفع المحلي السريع — تأكد أن php.ini لديك:
# upload_max_filesize=128M
# post_max_size=128M
# max_file_uploads=20
# memory_limit=256M

VITE_APP_NAME="${APP_NAME}"

SHARE_URL=

AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_MAX_IMAGES_PER_GENERATION=3

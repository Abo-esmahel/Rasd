APP_NAME="نظام ملاحظات المراقبة"
APP_ENV=local
APP_KEY=
# تحذير أمني: لا تضبط APP_DEBUG=true في الإنتاج إطلاقاً — يعرض Stack Traces ومسارات السيرفر.
APP_DEBUG=false
APP_URL=http://localhost:8000
# للنشر على سيرفر/شبكة محلية ضع عنوانه هنا، مثلاً: APP_URL=http://192.168.1.50:8000
# (تطبيق الجوال يكتشف السيرفر تلقائياً، وهذا العنوان للروابط والمشاركة فقط)

# محرك PDF للطباعة (Chrome headless عبر /api/print).
# إن تُرك فارغاً تُفحص المسارات الشائعة + PATH تلقائياً — يعمل بأي سيرفر.
# CHROME_BIN=/usr/bin/google-chrome-stable
# مصغّرات الفيديو (اختياري — بديلها شارة نصية تلقائياً).
# FFMPEG_BIN=/usr/bin/ffmpeg

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Damascus

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# توليد PDF للطباعة من الجوال.
# true = في عامل الطابور (queue:work). هذا المطلوب في الإنتاج: خدمة queue في
#        docker-compose تشغّله. وبدون عامل، تتراكم المهام في جدول jobs بلا من يلتقطها.
# false = داخل الطلب مباشرة. للتطوير المحلي بلا عامل طابور.
# وفي الحالتين يسري PDF_QUEUE_GRACE_SECONDS كشبكة أمان: إن بقي المستند في حالة
# generating هذه المدة، يولّده الطلب نفسه بدل أن ينتظر العميل ثم يفشل.
PDF_QUEUE_ENABLED=true
PDF_QUEUE_GRACE_SECONDS=10

CACHE_STORE=database

# ولّد قيمة عشوائية: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# التطبيق يرفض الإقلاع إذا كان السر فارغاً أو أقصر من 32 حرفاً.
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# حدود المرفقات (كيلوبايت) — يقيسها التطبيق قبل الإرسال ويعرضها للمستخدم.
MAX_IMAGE_SIZE=40960
MAX_VIDEO_SIZE=512000
MAX_ATTACHMENTS_PER_NOTE=10
MAX_ATTACHMENTS_PER_SUBMISSION=5
MAX_AUDIO_SIZE=536870912

# حدود PHP الفعلية (بايت) — تُطبَّق عبر php.ini المشروع عند التشغيل بـ ./serve.sh،
# لأن upload_max_filesize من نوع PHP_INI_PERDIR ولا يمكن تغييره من داخل التطبيق.
# غيّر القيم في php.ini و .env معاً لتبقى متسقة.
MAX_ATTACHMENT_FILE_BYTES=536870912
MAX_ATTACHMENT_REQUEST_BYTES=1073741824
IMAGE_MAX_DIMENSION=1920
IMAGE_JPEG_QUALITY=82
IMAGE_WEBP_QUALITY=80
# للرفع المحلي السريع — تأكد أن php.ini لديك:
# upload_max_filesize=128M
# post_max_size=128M
# max_file_uploads=20
# memory_limit=256M

VITE_APP_NAME="${APP_NAME}"

SHARE_URL=

AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=

# دفع الويب (Web Push) — بدونه تُعطَّل إشعارات المتصفح silently.
# ولّدها بـ: php artisan webpush:generate (إن توفرت) أو عبر مكتبة minishlink/web-push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# البريد (الافتراضي log — لا يُرسل شيئاً). فعّله فقط عند الحاجة:
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="${APP_NAME}"

# كلمة مرور مستخدمي البذور التجريبية (غيّرها قبل أي نشر حقيقي).
SEED_DEMO_PASSWORD=password
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_MAX_IMAGES_PER_GENERATION=3

# روابط PDF داخل الوثيقة: عنوان السيرفر كما يُفتح من الجوال على الشبكة
# PDF_PUBLIC_BASE_URL=http://192.168.10.138:8000
